# macOS
.DS_Store

# editors
*.swp
*.swo
.idea/
.vscode/

# tmux plugins (TPM clones at runtime, install with `prefix + I`)
config/tmux/plugins/

# nvim runtime caches (regenerated at runtime, not source)
config/nvim/mason/
config/nvim/spell/
config/nvim/swap/
config/nvim/undo/
config/nvim/view/
config/nvim/shada

# atuin install receipt (regenerated by cargo-dist installer, machine-specific path)
config/atuin/atuin-receipt.json

# backups created by link-configs.sh
*.bak
*.bak.*

# ghostty shaders (vendored third-party .glsl, not referenced by config/ghostty/config)
config/ghostty/shaders/
